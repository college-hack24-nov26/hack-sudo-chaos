# ==============================================================================
# YumSure Backend Configuration — Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' inside the 'backend/' directory:
#    cp backend/.env.example backend/.env
# 2. Replace placeholders with your actual database credentials.
# 3. DO NOT COMMIT .env TO VERSION CONTROL (enforced by .gitignore).
# ==============================================================================

# Application Runtime Settings
APP_NAME=YumSure
APP_ENV=development
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 1. APPLICATION DATABASE CONNECTION (DATABASE_URL)
# Used by FastAPI backend for runtime queries and repository operations.
# Driver: Uses SQLAlchemy with Psycopg 3 ('postgresql+psycopg://').
# ------------------------------------------------------------------------------
# Option A (Recommended for Shared Cloud Dev): Supabase Session Pooler (port 5432) or Transaction Pooler (port 6543)
# Note: For URL-encoded characters in passwords (e.g. '@' -> '%40'), encode them properly.
# DATABASE_URL=postgresql+psycopg://postgres.<your-project-ref>:<your-password>@aws-0-<your-region>.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: Direct Supabase Connection (port 5432)
# DATABASE_URL=postgresql+psycopg://postgres:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# Option C: Local PostgreSQL Development Database
DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/yumsure_db

# ------------------------------------------------------------------------------
# 2. ALEMBIC MIGRATION CONNECTION (ALEMBIC_DATABASE_URL)
# Used exclusively for schema migrations, revision tracking, and DDL operations.
# ------------------------------------------------------------------------------
# IMPORTANT SUPABASE NOTE:
# Alembic requires transactional DDL, table locks, and advisory locks.
# Therefore, Alembic CANNOT run through Supabase Transaction Pooler (port 6543).
# You MUST point ALEMBIC_DATABASE_URL to:
# - Direct connection: db.<your-project-ref>.supabase.co:5432
# - OR Session Pooler: aws-0-<your-region>.pooler.supabase.com:5432
# If omitted, Alembic falls back to DATABASE_URL.
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:<your-password>@db.<your-project-ref>.supabase.co:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 3. DEDICATED ISOLATED TEST DATABASE (TEST_DATABASE_URL)
# Used exclusively by integration test suites (e.g. test_product_repository.py).
# ------------------------------------------------------------------------------
# SAFETY RULES:
# - Integration tests strictly refuse to run if TEST_DATABASE_URL is not set.
# - Integration tests strictly refuse to run if target host points to Supabase.
# - Integration tests strictly refuse to run if database name does not contain 'test'.
# - Tests execute within transactions that are rolled back on completion.
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_local_password@localhost:5432/yumsure_test

# ------------------------------------------------------------------------------
# 4. DATABASE CONNECTION POOL TUNING (FastAPI Persistent Backend)
# ------------------------------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
