# ==============================================================================
# YumSure Backend Configuration — Environment Template
# COPY THIS FILE TO .env AND REPLACE PLACEHOLDERS WITH LOCAL/PROD CREDENTIALS
# DO NOT COMMIT ACTUAL PASSWORDS OR CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Application Settings
APP_NAME=YumSure
APP_ENV=development
API_V1_STR=/api/v1

# Database Connection (PostgreSQL 18 via Psycopg 3 synchronous driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/yumsure_db

