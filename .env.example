# ==============================================================================
# YumSure Root Configuration — Environment Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to 'backend/.env' (where the backend loads configuration):
# cp .env.example backend/.env
# ==============================================================================

APP_NAME=YumSure
APP_ENV=development
API_V1_STR=/api/v1

# FastAPI Application Connection (Supabase Session Pooler or Local PG)
# For Supabase IPv4 / Session Pooler: postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/yumsure_db

# Alembic Migration Connection (Port 5432 Session Pooler or Direct)
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Dedicated Isolated Local Test Database
TEST_DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/yumsure_test

# Connection Pool Tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

